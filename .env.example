# 应用配置
APP_NAME=MicroBubble Agent
# APP_ENV: development | production（影响 CORS、SECRET_KEY 校验等行为）
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-random-string

# 数据库 (Docker 内部网络用 db:5432，宿主机用 localhost:5432)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/microbubble
# DB 密码已轮换 (L-14, 2026-09-29); 不再提供可用的示例默认值 ——
# 沿用本文件既有惯例 (SECRET_KEY / MINIO_SECRET_KEY 都是 change-* 占位符),
# 复制成 .env 后必须替换为真实随机值, 且 .env 已被 .gitignore 排除。
# 生成: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-postgres-password

# Redis (Docker 内部网络)
REDIS_URL=redis://redis:6379/0

# MinIO对象存储
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=microbubble
MINIO_SECURE=false

# 站点域名（用于构造头像等公网可访问的 URL）
SITE_DOMAIN=agent.mnb-lab.cn

# Claude API
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# 留空则使用各模块默认模型（代理服务需指定如 mimo-v2.5）
CLAUDE_MODEL=
# Claude 生成参数
CLAUDE_MAX_TOKENS=8192
SESSION_WINDOW_SIZE=30

# MiMo API (OpenAI 兼容，用于视觉等多模态功能)
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# 腾讯会议
TENCENT_MEETING_SDK_ID=your-sdk-id
TENCENT_MEETING_SDK_KEY=your-sdk-key
TENCENT_MEETING_USERID=your-user-id

# (2026-09 企业微信下线: WECHAT_* 配置段已删)

# Whisper语音识别 (已退役 2026-06-30, 迁移到下方 SenseVoice)
# ⚠️ 三项当前零消费者: 生产路由只走 GPU 7B / SenseVoice, whisper 服务段在
#    docker-compose.yml 已注释。保留作回滚, 但回滚需人工启用(取消 compose 段注释
#    + 恢复 app/voice/asr.py 的 Whisper 路径), 改这几个值本身不生效。
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_SERVICE_URL=http://whisper:8002

# 2026-06-30 ASR 迁移: SenseVoice 服务配置
# 默认 ASR 后端 (sensevoice 优; whisper 已退役, 见上方)
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cuda
SENSEVOICE_SERVICE_URL=http://sensevoice:8003
# ⚠️ ASR_LONG_MEETING_THRESHOLD_SEC 已**废弃** (不在 app/config.py, 全仓零消费者)。
#    真实路由见 app/services/post_meeting_tasks.py:180-186, 由 GPU_ASR_* 控制:
#      > GPU_ASR_MAX_SEC(默认5400s) → 直接跳过 7B 走 SenseVoice
#      >= GPU_ASR_MIN_SEC(默认180s) → 走 GPU 7B (VibeVoice-ASR)
#      两者之间/服务不健康 → SenseVoice。**两条路都不走 Whisper。**
#    不要再按下面的旧说明(音频>=600s 自动用 Whisper)调参——那条机制已不存在。
# ASR_LONG_MEETING_THRESHOLD_SEC=600  # 已废弃, 保留行内注释以防误用
# batch_size_s 防 OOM (CLAUDE.md memory/asr-benchmark-2026-06-30 铁律 1)
SENSEVOICE_BATCH_SIZE_S=60
# ⚠️ ASR_DEFAULT_BACKEND 当前**零消费者** (生产路由不读它, 见 post_meeting_tasks.py
#    :180-186 的 GPU_ASR_ENABLED/MIN/MAX 闸门)。保留仅为回滚语义说明。
ASR_DEFAULT_BACKEND=sensevoice

# HuggingFace 镜像源（国内网络建议设置）
HF_ENDPOINT=

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT 令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis 会话 TTL（秒，默认 48 小时）
SESSION_TTL=172800

# 文件上传大小限制（MB）
MAX_UPLOAD_SIZE_MB=50

# CORS 允许的额外源（逗号分隔，可选）
CORS_ORIGINS=

# 服务器
HOST=0.0.0.0
PORT=8000
