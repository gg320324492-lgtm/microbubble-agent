# 声纹流水线 GPU 服务（VAD + 3D-Speaker + Whisper）
# base image pinned on 2026-07-29 for CVE tracking (W86-C-1 Trivy)
# L-8 (2026-10-07): CUDA tag 不动 (12.1.1-runtime-ubuntu22.04); apt 层加纯 OS 安全升级;
# pip 层修构建坏死 —— jammy 系统 pip 22.0.2 resolvelib get_topological_weights
# AssertionError (上游 pip<23 已知 bug, 此前构建从未通过 → 从未被扫描)。
# python3.11 与 python3-pip 共享 /usr/lib/python3/dist-packages, 故 python3.11 -m pip 可先自举。
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    python3.11 python3.11-dev python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# 2026-10-12 L-8: **删掉 `--upgrade pip`** (承 679721665 对 whisper/funasr 的同型修复)。
#   本镜像的 pip/setuptools 来自 apt 的 `python3-pip`, 但 `--upgrade pip` 同样会把它
#   拉到新版 —— 实测 CI 构建后是 pip 26.2.1, 其 `pip/_vendor/` 内置 setuptools
#   70.3.0, 命中 CVE-2025-47273 (FixedVersion 78.1.1)。
#   ⚠️ 本镜像里**真正安装**的 setuptools 是 84.0.0 (干净), 报出的 70.3.0 只是
#   pip 的 vendored 副本 —— 两者别混谈(类 20.220: 报告字段要说清是哪一份)。
#   保留 `--upgrade setuptools`: 那装的是独立包, 84.0.0 无 CVE。
RUN python3.11 -m pip install --no-cache-dir --upgrade setuptools && \
    python3.11 -m pip install --no-cache-dir -r requirements.txt

# 不复制 app 代码 — 通过 volume 挂载（与主容器共享）
CMD ["python", "-c", "print('voice-pipeline 已通过主 app 容器内的 /app 挂载运行')"]
