# Docker base 商业化版 (W72 Phase 8 起步)
#
# 目标: 商业化交付的多阶段 Docker 镜像
# - 多阶段构建 (builder + runtime)
# - 商业化 watermark 配置
# - License 服务端校验钩子
# - 安全加固 (非 root 用户 + read-only fs + seccomp)
# - 镜像大小 < 800MB
#
# 不替代 docker/Dockerfile, 是商业化专用, 由 commercial/saas-platform/deploy.sh 调用

# ===== Stage 1: builder =====
# base image bumped for L-8 image-scan CVE zeroing (2026-10-07; prior pin 2026-07-29 W86-C-1)
FROM python:3.11.17-slim AS builder

WORKDIR /build

# 商业化 watermark
ENV MICROBUBBLE_COMMERCIAL=1 \
    MICROBUBBLE_BUILD_TYPE=commercial \
    MICROBUBBLE_BUILD_DATE=2026-07-27 \
    MICROBUBBLE_PHASE=8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# builder 阶段装编译依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# L-8 (2026-10-07): requirements-commercial.txt 在整个 git 历史 (--full-history) 与
# 全仓引用中均不存在 —— W72 B-5 写入 COPY 时即为占位, 从未落盘, 构建因此从未通过
# (image-scan 矩阵 commercial 长期静默跳扫)。二选一取"修 Dockerfile": 摘除该文件的
# COPY/install; 将来真要加商业化专属依赖时, 落盘文件后把这两处一并恢复。
COPY requirements.txt ./
RUN pip install --upgrade setuptools \
    && pip install --user -r requirements.txt

# ===== Stage 2: runtime =====
# base image bumped for L-8 image-scan CVE zeroing (2026-10-07; prior pin 2026-07-29 W86-C-1)
FROM python:3.11.17-slim AS runtime

# 商业化 watermark (继承 builder)
ENV MICROBUBBLE_COMMERCIAL=1 \
    MICROBUBBLE_PHASE=8 \
    # License 服务端校验 (离线 7 天宽限)
    MICROBUBBLE_LICENSE_SERVER=https://license.microbubble.cloud/v1 \
    MICROBUBBLE_LICENSE_GRACE_DAYS=7 \
    # 安全加固
    MICROBUBBLE_READONLY_FS=1 \
    MICROBUBBLE_SECCOMP_PROFILE=commercial-strict

# 非 root 用户
RUN groupadd -r microbubble && useradd -r -g microbubble -u 10001 microbubble \
    && mkdir -p /app /app/data /app/logs /app/commercial \
    && chown -R microbubble:microbubble /app

# 运行时只装必要依赖
# L-8 (2026-10-07): apt-get upgrade = 纯 OS 层安全升级 (debian-security 修复), 不动 pip pin。
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        libpq5 libffi8 libssl3 tini curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2026-10-12 L-8: **runtime 阶段也要升级 setuptools** —— 本文件是多阶段构建,
#   builder 段的 `pip install --upgrade setuptools` (:36) 装进的是 builder 自己的
#   /usr/local/lib/python3.11/site-packages, 而下面只 COPY 了 `/root/.local`,
#   **那份升级后的 setuptools 根本没进最终镜像**。runtime 是全新的
#   FROM python:3.11.17-slim ⇒ 保留基础镜像自带的 **setuptools 79.0.1**。
#
#   实测危害(trivy 同一份报告的文件清单 + setuptools 79.0.1 tarball 的 _vendor/ 清单
#   双向取证, 两条完全对上):
#       setuptools 79.0.1 _vendor/  →  jaraco.context 5.3.0  (CVE-2026-23949)
#                                      wheel        0.45.1  (CVE-2026-24049)
#       setuptools 84.0.0 _vendor/  →  jaraco_context 6.1.2 / wheel 0.46.3  (均已修复)
#   ⇒ commercial 的 6 条 HIGH 比 app / voice-pipeline 的 4 条多出的**正是这 2 条**;
#     那两个镜像是单阶段构建, `--upgrade setuptools` 生效 ⇒ setuptools 84.0.0。
#
#   ⚠️ 这是类 20.220 的一个变体: Dockerfile 里**写着**升级了 setuptools, 构建也成功,
#     但**副作用没发生在成品镜像里**(多阶段 COPY 只带走了一个目录)。判断"某个包装上了
#     没有"必须以**最终镜像内实测**为准, 不能读 Dockerfile 就以为它装过。
#   ⚠️ 本行**不升级 pip**: 与 Dockerfile / Dockerfile.voice-pipeline 同理,
#     `--upgrade pip` 会把 pip 的 `_vendor/setuptools` 拉到有 CVE 的 70.3.0。
RUN pip install --no-cache-dir --upgrade setuptools

# 复制 builder 阶段装好的 Python 包
COPY --from=builder /root/.local /home/microbubble/.local
ENV PATH=/home/microbubble/.local/bin:$PATH

WORKDIR /app

# 复制商业化代码 (限制范围)
COPY --chown=microbubble:microbubble commercial/ /app/commercial/
COPY --chown=microbubble:microbubble app/ /app/app/
COPY --chown=microbubble:microbubble alembic/ /app/alembic/
COPY --chown=microbubble:microbubble alembic.ini /app/alembic.ini
COPY --chown=microbubble:microbubble docker/commercial/entrypoint.sh /app/entrypoint.sh
COPY --chown=microbubble:microbubble docker/commercial/license-check.py /app/license-check.py

USER microbubble

# 时区
ENV TZ=Asia/Shanghai

# License 校验 + 入口
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

EXPOSE 8000

# Labels
LABEL maintainer="MicroBubble Commercial <commercial@microbubble.cloud>" \
      phase="8" \
      watermark="microbubble-commercial-2026-07-27" \
      license="commercial-tier" \
      version="8.0.0-commercial"
