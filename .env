# 应用配置
APP_NAME=MicroBubble Agent
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=KFwPM56LbwMy1ConIaXyCaUxwUvOWTRe1pZOxviA511Exe01kGH15HDtHzIkcjvBLuLgYB63ahmvQ1DfYaj2fw

# 2026-06-18 修复：APP_ENV=development 导致 CORS 白名单只包含 localhost
# 浏览器从 https://agent.mnb-lab.cn 发请求时 OPTIONS preflight 被拒
# → 所有 /upload-audio /audio-chunk 等端点 CORS 阻断
# 用 CORS_ORIGINS 绕过 APP_ENV 条件（app/main.py:105 总是会读取此变量）
CORS_ORIGINS=https://agent.mnb-lab.cn,http://agent.mnb-lab.cn

# 数据库 (Docker 内部网络用 db:5432，宿主机用 localhost:5432)
# v28 step 53: 之前的 ${POSTGRES_PASSWORD} 不会被 env_file 展开，导致认证失败
# 改为直接写明文（值与下面 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql://postgres:microbubble2026@db:5432/microbubble
POSTGRES_PASSWORD=microbubble2026

# Redis (Docker 内部网络)
REDIS_URL=redis://redis:6379/0

# MinIO对象存储
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio2026secure
MINIO_BUCKET=microbubble

# Claude API
CLAUDE_API_KEY=tp-c2dh4lwgx2519tsuoffa8npxfcqofbiyaew94pwt4bc5yjlq
CLAUDE_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# MiMo API (OpenAI 兼容，支持联网搜索)
MIMO_API_KEY=tp-c2dh4lwgx2519tsuoffa8npxfcqofbiyaew94pwt4bc5yjlq
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# 腾讯会议
TENCENT_MEETING_APP_ID=your-app-id
TENCENT_MEETING_APP_SECRET=your-app-secret

# 企业微信
WECHAT_CORP_ID=wwd6f28c99f88b9349
WECHAT_AGENT_ID=1000002
WECHAT_SECRET=TD2akZJB1WOy0wL7WFKTXz737KPBJR1qdUaDubZ8EOo
WECHAT_CALLBACK_TOKEN=JrHgarRN
WECHAT_ENCODING_AES_KEY=eoTzBvspE4cylnTb9hQnL9u4gETOg3Rurj7QlKBcf0g
WECHAT_EXTERNAL_SENDER=xiaoqi

# Whisper语音识别 (服务器无GPU用base+cpu，有GPU用large-v3+cuda)
