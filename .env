# 2026-07-15 #P2: 与 ollama backend 对齐 (CLAUDE_MODEL 仅 anthropic backend 用作主模型,
# 实际 synthesis 走 thinking_config.model=qwen2.5vl:7b, 此处改 qwen2.5vl:7b 保持 .env 一致)
# 2026-08-18 Stage 2B §5 narrow authorization: 切到 qwen2.5vl:7b 本地多模态
CLAUDE_MODEL=mimo-v2.5
HF_ENDPOINT=https://hf-mirror.com

# 2026-06-14 方案 C Stage 5 收尾：代理 API 不支持 claude-haiku-4-5-20251001 / claude-sonnet-4-6
# 改用主模型 mimo-v2.5（mimo 代理兼容）
# 2026-07-15 #P2 修复：LLM_BACKEND=ollama (7/13 #P1 切本地) 但 3 个辅助模型仍设 mimo-v2.5
# 导致 intent_classifier / 工具压缩 / 自评调 ollama 用 mimo 名 → 全部失败 → fallback
# 修法：与 LLM_BACKEND 对齐, 都用 qwen3:8b (balanced 同模型, 性能/质量稳定)
# 回滚 mimo: 改回 AGENT_*_MODEL=mimo-v2.5 + LLM_BACKEND=openai_compat
AGENT_COMPRESSOR_MODEL=qwen2.5vl:7b
AGENT_INTENT_MODEL=qwen2.5vl:7b
AGENT_REFLECTION_MODEL=qwen2.5vl:7b

# 2026-06-24 v29 GPU 启用：embedding 模型配置（plan file: breezy-discovering-ripple.md）
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=64

# 2026-07-01 #001 BGE m3 reranker: 取代 Self-RAG #009 judge 路径
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=32

# 2026-06-24 v29 step 2 收官: 模型已下载到本地, 强制离线模式避免 SSL 握手抖动
HF_HUB_OFFLINE=1

# === LLM Backend 切换 (2026-07-01 v1 ToolCallConverter) ===
# 默认 anthropic (走 mimo Anthropic-protocol)
# 切换 openai_compat 走 mimo /v1: 需要 LLM_OPENAI_COMPAT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 切换 ollama 走本地: 需要 OLLAMA_MODEL=qwen3:8b (8b) 或 qwen3:14b (14b)
# 2026-07-02 3-way benchmark 收官: 推荐生产用 mimo openai_compat, 8b 是 offline fallback
# 2026-07-12 P0-#1 修复: ollama 后台测试残留 → 还原 openai_compat (mimo cloud)
# 2026-07-13 #P1 三档模式上线: 切到本地 Ollama (docker-compose.yml ollama service)
# 2026-08-18 Stage 2B §5 narrow authorization: 切到 qwen2.5vl:7b 本地多模态
# - fast/balanced 走 qwen2.5vl:7b (多模态 + thinking disabled 用作 synthesis)
# - deep 走 deepseek-r1-distill-qwen:7b (reasoning_content 通道)
# - 回滚 mimo: LLM_BACKEND=openai_compat (一行切换, OLLAMA_* 保留作 fallback)
LLM_BACKEND=ollama
# ollama 走 docker compose 内 service name (同网络, 不用 host.docker.internal)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# deep 模式默认模型 (2026-07-13 pull 后修正: ollama library tag 是 deepseek-r1:7b)
OLLAMA_FALLBACK_MODEL=deepseek-r1:7b
LLM_OPENAI_COMPAT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_OPENAI_COMPAT_MODEL=mimo-v2.5
# 备选 (切回 14b 离线 batch): OLLAMA_MODEL=qwen3:14b
# OLLAMA_MODEL=qwen3:14b
DEBUG_DUMP_LLM_INPUT=1

