# 2026-08-18 RRF Canary Phase 1 — internal/admin allowlist activation
# Per Phase 1 spec §2: explicit user allowlist is authoritative for first live phase.
# RRF_CANARY_ROLES remains default (admin,leader) but allowlist takes priority.
# Empty RRF_CANARY_USER_IDS = no allowlist; set to comma-separated user IDs to enable.
# Per spec §4: real user IDs MUST NOT be committed into Git artifacts;
# the .env file is bind-mounted from host and is NOT Git-tracked.
RRF_CANARY_PHASE1_ENABLED=true
RRF_CANARY_USER_IDS=2,3,1282
RRF_CANARY_ROLES=

AGENT_SYNTHESIS_MODEL=mimo-v2.5
AGENT_INTENT_MODEL=mimo-v2.5
AGENT_REFLECTION_MODEL=mimo-v2.5
AGENT_COMPRESSOR_MODEL=mimo-v2.5
