# =============================================================================
# 2026-10-13: crcmod 静默降级为纯 Python (类 20.220 同族)
# =============================================================================
# 【症状】生产容器内实测 `hasattr(crcmod.crcmod, "_crcfunext")` == **False**,
#   而 app 镜像是 True —— 两个镜像行为不一致。功能不坏 (CRC 结果仍然正确),
#   但实测吞吐 **23 MiB/s vs app 镜像的 610 MiB/s = 慢 26.5 倍**。
#
# 【真根因 —— 三层, 每层都伪装成 "成功", 全靠实测才拆得开】
#   ① 本镜像没有 gcc, `crcmod` 走 sdist 分支;
#   ② crcmod 1.7 的 setup.py 用**裸 `except:`** 包住 `setup(ext_modules=...)`:
#        except:  # If there are any compilation errors or there are no build
#                  # tools available ... delete the extension module and try to
#                  # install the pure Python version.
#        del setup_dict['ext_modules']; setup(**setup_dict)
#      ⇒ **编译失败不报错**, 静默产出 `crcmod-1.7-py3-none-any.whl`。
#      实测 (一次性容器): 无编译器时 pip 输出的是
#      "Building wheel ... finished with status 'done'" —— **字面全绿**。
#   ③ ⚠️ **只装 gcc 仍然失败** —— 这是最容易漏的一层:
#      实测 `gcc -c python3/src/_crcfunext.c` 报
#        fatal error: stdlib.h: No such file or directory
#      原因是 python:3.11.17-slim **不含 libc6-dev** (实测 `dpkg -s libc6-dev`
#      → ABSENT), 而 stdlib.h 属于 libc6-dev。**gcc 只是驱动, 头文件在 libc6-dev**。
#      ⇒ 必须 `gcc` + `libc6-dev` 同时装。缺任一个都落进 ② 的静默兜底。
#
# 【为什么单独开一个 builder 而不是给主段加 gcc】—— 实测 CVE 代价:
#   `apt-get install gcc libc6-dev` 会顺带拉入 **linux-libc-dev**,
#   而它在 app 镜像实测**单独就带 196 条 HIGH/CRITICAL** (CVE 最早到 2015)。
#   本镜像改造前 CRITICAL+HIGH 基线 = **266** (trivy 0.72.0, 按 Result.Type 分组:
#   全部 debian / python-pkg 0 条 / `-dev` 贡献 0 条), 若把 gcc 留在主段,
#   仅 linux-libc-dev 一项就会把 266 推到 **~462 (+73%)** ——
#   相当于把 2026-10-12 刚做完的 L-8 CVE 治理**全部倒推回去**。
#   ⇒ 编译器只在构建期存在, 绝不进最终镜像。
#
# 【为什么搬运的是"单个 .so"而不是像 app 镜像那样"整份 site-packages"】
#   app 镜像搬运整份是因为它装了 65 个直接依赖; **本镜像只装 funasr/torch 等少数包**,
#   整份搬运会让 builder 的 pip 版本/setuptools 状态成为运行时隐式依赖, 风险面更大。
#   实测 `ldd _crcfunext*.so` = **statically linked** ⇒ 只拷这一个文件即可,
#   零动态库依赖, runtime 连 libstdc++ 都不需要。
#   ⚠️ COPY 是合并语义, 但这里**不需要先 rm -rf**: 目标路径下原本**不存在**
#   该文件 (纯 Python 版没有 .so), 是新增而非覆盖 ⇒ 不存在 app 镜像那种
#   "两份 dist-info 并存" 的坑 (那个坑只在整份拷贝 site-packages 时才会发生)。
FROM python:3.11.17-slim-bookworm AS crcmod-builder

RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm main contrib\n' > /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm-updates main contrib\n' >> /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib\n' >> /etc/apt/sources.list

# gcc + libc6-dev **必须成对** (见上文第 ③ 层)。--no-install-recommends 是为了
# 不把 build-essential 全家桶拉进来 (本段产物只有一个 .so, 用不到)。
# ⚠️ 这里刻意**不**加 gcc 之外的编译器工具链: 实测 crcmod 只需要 C 编译器。
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# ⚠️ **必须 --no-binary**: crcmod 在 PyPI 上**没有任何 Linux wheel**
#   (实测 1.7 的 files 只有 crcmod-1.7.tar.gz + 4 个 Windows .msi), 所以默认
#   本来就走 sdist; 但显式写出来是为了**让"这次确实编译了"成为可读事实**,
#   而不是依赖"恰好没有 wheel"这种随时会变的外部条件 (类 20.224: 冲突链会随
#   别的改动悄悄作废, 结论不该只存在于注释里)。
# ⚠️ 版本钉 1.7 与主段 oss2 解析出的版本一致 (实测主段装的是 crcmod-1.7)。
RUN pip3 install --no-cache-dir --no-binary crcmod crcmod==1.7

# ⚠️ **fail-loud 守门**: 在 builder 里就断言 C 扩展真的编出来了。
#   没有这一步, 上游 ② 的静默兜底会把"编译失败"变成"构建成功但产物是纯 Python",
#   而 COPY 依然会成功 —— 正是类 20.220 描述的形态。
#   (判据用 hasattr 而非"文件存在", 因为纯 Python 包目录下也可能残留同名文件。)
RUN python3 -c "import crcmod.crcmod as m; assert hasattr(m, '_crcfunext'), 'crcmod C extension missing'; print('builder: crcmod C extension OK')"

# =============================================================================
# 主段: 保持单阶段 (无编译器, CVE 与改造前一致)
# =============================================================================
# base image bumped for L-8 image-scan CVE zeroing (2026-10-07; prior pin 2026-07-29 W86-C-1)
FROM python:3.11.17-slim-bookworm

# 阿里云镜像源 (bookworm-security 路径已正确支持)
# 2026-06-30 ASR 迁移: 与 Dockerfile.whisper 镜像源一致
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm main contrib\n' > /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm-updates main contrib\n' >> /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib\n' >> /etc/apt/sources.list

# Install system dependencies (with retry for transient 502 Bad Gateway)
# L-8 (2026-10-07): apt-get upgrade = 纯 OS 层安全升级 (debian-security 修复), 不动 pip pin;
# 主/回退两个分支都带上, 保证任一分支走到 OS 库都是最新。
#
# 2026-10-13 (对标 app 镜像 multi-stage 改造): 删掉 7 个 libav*-dev + pkg-config。
#
# 【为什么删 —— 实测依据, 非推断】
#  ① 本镜像**不编译任何东西**: `which gcc` = no gcc, 且 pip 全是预编译 wheel
#     (`--prefer-binary`), 没有走源码构建的分支 ⇒ `-dev` 的头文件/静态库/链接期
#     `libav*.so` 无版本化符号链接无人使用。app 镜像 2026-10-13 改造实测 CVE 626→293 同因。
#  ② **运行时库一个都不会少**: `dpkg -s ffmpeg` 实测
#     Depends: libavcodec59 libavdevice59 libavfilter8 libavformat59 libavutil57
#              libpostproc56 libswresample4 libswscale6
#     —— 与被删的 8 个 `-dev`(7 个显式 + libavfilter-dev 传递拉入的 libpostproc-dev)
#     **一一对应的运行时 counter**。删 `-dev` 只少了头文件和链接期符号链接,
#     `libavcodec.so.59.37.100` 这类真实运行时 .so 全部由 ffmpeg 提供。
#  ③ 实测收益: 这 8 个 `-dev` 各自带 16 条 CRITICAL+HIGH, 合计 **128 条**
#     (funasr 镜像 466 → 338)。
#  ⚠️ **注意这不是全部**: 8 个运行时库 libavcodec59/.../libswscale6 各同样 16 条
#     (合计 128) + ffmpeg 自身 16 条, 整个 ffmpeg 家族 = 272 条。删 `-dev` 只拿其中
#     一半; 要进一步降 CVE 必须处理 ffmpeg 本体(其 Depends 的运行时库), 那是另一次立项。
#
# 【为什么 ffmpeg 必须保留 —— 实测依据】
#  ① `app/sensevoice_server.py:141` 的 CMD 入口 `bytes_to_array` 用
#     `subprocess.run(["ffmpeg","-y","-i",...,"-ar","16000","-ac","1","-f","wav",...])`
#     做任意格式 → 16kHz mono 解码转码, **是生产在跑的主路径**, 删 ffmpeg = ASR 全线崩。
#  ② 本镜像 `pip list` **没有 `av`/PyAV** (实测确认), 故没有 PyAV 那条备胎解码路径;
#     funasr 的音频入参 100% 依赖这个 CLI。删它属于功能改动, 超出本次范围。
RUN apt-get update && apt-get upgrade -y && apt-get install -y --fix-missing \
    ffmpeg \
    || (apt-get update && apt-get upgrade -y && apt-get install -y --fix-missing --no-install-recommends \
        ffmpeg) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2026-06-30 ASR 迁移: 安装 FunASR + SenseVoice + torch 依赖
# 关键 1: 必须自带 torch (sensevoice 容器与 app 容器独立, 不能假设继承)
# 关键 2: torch 2.4.0 不支持 sm_120 (Blackwell RTX 5090), 必须用 torch 2.7+ 才支持
# 关键 3: torch CUDA wheel 走 PyPI 官方 cu128 源 (清华源限速 torch 2.12+)
#
# 2026-10-11 L-8 (修 image-scan funasr job 4 条 HIGH, 与 whisper 同型同根因):
# ⚠️ **本块刻意不再 `pip install --upgrade pip`** —— 消 CVE 的关键, 别加回来。
# 基础镜像自带 pip 24.0, `pip/_vendor/` vendor 的是
#   msgpack==1.0.5 / urllib3==1.26.17 / setuptools==68.0.0 → trivy 不报;
# `--upgrade pip` 到 26.2.1 后 vendor 变成
#   msgpack==1.1.2 (GHSA-6v7p-g79w-8964) / urllib3==2.7.0 (CVE-2026-97687/97689)
#   / setuptools==70.3.0 (CVE-2025-47273) → trivy 逐条报 (按 pip/_vendor/vendor.txt)。
# 实测: 顶层 `pip install "msgpack>=1.2.1"` 等**升不动 vendor**, 只有"不升级 pip"有效。
RUN pip3 install --no-cache-dir --upgrade setuptools && \
    pip3 install --no-cache-dir --prefer-binary \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    torch==2.7.0 \
    torchaudio==2.7.0 \
    && \
    # ⚠️⚠️ **下面两个版本串必须加引号，否则整行静默失效**（2026-10-13 实测确认）：
    # `RUN` 走 `/bin/sh`，**shell 会把 `>` 当重定向符**。不加引号时
    #     funasr>=1.3.0      →   funasr > =1.3.0    (重定向到文件 `=1.3.0`)
    #     modelscope>=1.14.0  →   modelscope > =1.14.0
    # 即 pip 收到的是**裸包名**（版本约束被整个丢掉，装最新版），而 shell 把 pip 的
    # stdout 重定向进了 `/app/=1.14.0`（实测该文件 24882 字节，装的就是这段输出）。
    # ⇒ **生产镜像里长期躺着两个垃圾文件** `/app/=1.3.0`(0 字节) 与 `/app/=1.14.0`。
    # 本次加引号后**行为不变**（`>=` 仍解析到最新版，实测 funasr 1.4.16 / modelscope 1.40.2），
    # 但约束终于真正生效 —— 将来想加**上界**（如 `<2`）时它才会起作用，否则上界会被 shell 吃掉。
    # 同型坑已在 `Dockerfile.mcp` 于 2026-10-11 修过一次（其文件内有完整留档）。
    pip3 install --no-cache-dir --prefer-binary \
    "funasr>=1.3.0" \
    "modelscope>=1.14.0" \
    nvidia-cublas-cu12 \
    nvidia-cuda-nvrtc-cu12 \
    fastapi uvicorn python-multipart

# ---- crcmod C 扩展 (2026-10-13): 从 builder 搬单个 .so, 主段**不引入任何编译器** ----
# 主段上面的 pip install 已经把 crcmod 装成了**纯 Python 版** (无 .so)。
# 这里把 builder 编出来的 .so 补进去, 让 `_crcfunext` 可用。
#   ⚠️ 实测 `ldd` = statically linked ⇒ 单文件搬运, runtime 无需任何额外 .so 依赖。
#   ⚠️ COPY 是**新增**而非覆盖 (目标路径原本无此文件), 故不需要 app 镜像那种
#      "先 rm -rf 再拷" —— 那个坑只在整份拷贝 site-packages 时才成立。
RUN mkdir -p /usr/local/lib/python3.11/site-packages/crcmod
COPY --from=crcmod-builder /usr/local/lib/python3.11/site-packages/crcmod/_crcfunext.cpython-311-x86_64-linux-gnu.so \
     /usr/local/lib/python3.11/site-packages/crcmod/_crcfunext.cpython-311-x86_64-linux-gnu.so

# ⚠️ **主段也要再验一次** (类 20.220: 守门必须验副作用真的发生, 且要在**最终镜像**里验)。
#   builder 段的断言只证明"编译成功", 不证明"搬运成功" —— COPY 路径写错、
#   目标目录层级不对、文件名 ABI tag 不匹配, 都会让 .so 到不了 Python 能 import 的位置,
#   而这些**都不会让 docker build 失败**。
#   判据固定用 `hasattr(crcmod.crcmod, "_crcfunext")` —— 这正是类 20.220 指定的判据
#   (功能正常、CRC 结果正确, 只有速度差 26 倍, 静态检查与测试全绿都发现不了)。
RUN python3 -c "import crcmod.crcmod as m; assert hasattr(m, '_crcfunext'), 'crcmod C extension NOT delivered to runtime'; print('runtime: crcmod C extension OK')"

# 设置CUDA库路径（与 whisper 一致）
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib

# v31.3.1 同样适用: bind mount source → docker compose restart 即生效
# docker-compose.yml: ./app/sensevoice_server.py:/app/sensevoice_server.py:ro

# 环境变量
ENV MODEL=iic/SenseVoiceSmall
ENV DEVICE=cuda

# 暴露端口（8003 与 whisper 8002 区分）
EXPOSE 8003

# 启动命令 - 使用自定义 FastAPI 服务
CMD ["python3", "sensevoice_server.py"]