{
  "name": "microbubble-agent-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx vite --port 3000 --strictPort=false",
    "build": "vite build && node scripts/postbuild-fix-manifest.js",
    "build:raw": "vite build",
    "build:pwa": "vite build && node scripts/postbuild-fix-manifest.js",
    "postbuild:fix-manifest": "node scripts/postbuild-fix-manifest.js",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.{vue,css,scss}\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.{vue,css,scss}\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:playwright:a11y": "playwright test -c tests/visual/a11y/playwright.a11y.config.mjs",
    "test:playwright:visual": "playwright test",
    "test:playwright": "npm run test:playwright:a11y && npm run test:playwright:visual",
    "test:playwright:update": "playwright test --update-snapshots",
    "load:chat": "k6 run --vus 10 --duration 30s ../scripts/k6/chat_stream.js",
    "load:ws": "k6 run --vus 10 --duration 30s ../scripts/k6/ws_notifications.js",
    "load:drive": "k6 run --vus 5 --duration 30s ../scripts/k6/drive_collab.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@nutui/nutui": "^4.3.14",
    "@sentry/browser": "8.55.2",
    "@sentry/vue": "8.55.2",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.7",
    "echarts": "^5.6.0",
    "element-plus": "^2.4.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.4",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "spark-md5": "^3.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.2.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "hint": "^7.1.13",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "tar": "^7.5.22",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.4",
    "form-data": "^4.0.6",
    "immutable": "^5.1.9",
    "js-yaml": "^4.3.0",
    "undici": "^7.29.0",
    "ws": "^8.21.1",
    "tar-fs": "^2.1.5"
  }
}
