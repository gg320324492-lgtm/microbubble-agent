# base image bumped for L-8 image-scan CVE zeroing (2026-10-07; prior pin 2026-07-29 W86-C-1)
FROM python:3.11.17-slim-bookworm

# 阿里云镜像源 (bookworm-security 路径已正确支持)
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm main contrib\n' > /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian bookworm-updates main contrib\n' >> /etc/apt/sources.list && \
    printf 'deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib\n' >> /etc/apt/sources.list

# Install system dependencies (with retry for transient 502 Bad Gateway)
# L-8 (2026-10-07): apt-get upgrade = 纯 OS 层安全升级 (debian-security 修复), 不动 pip pin;
# 主/回退两个分支都带上, 保证任一分支走到 OS 库都是最新。
RUN apt-get update && apt-get upgrade -y && apt-get install -y --fix-missing \
    ffmpeg \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    pkg-config \
    || (apt-get update && apt-get upgrade -y && apt-get install -y --fix-missing --no-install-recommends \
        ffmpeg libavformat-dev libavcodec-dev libavdevice-dev \
        libavutil-dev libavfilter-dev libswscale-dev libswresample-dev \
        pkg-config) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装Python依赖 + CUDA运行时库（通过pip安装，避免下载大CUDA镜像）
#
# 2026-10-11 L-8 (修 image-scan whisper job 4 条 HIGH 全红):
# ⚠️ **本块刻意不再 `pip install --upgrade pip`** —— 这是消 CVE 的关键，别加回来。
# 实测根因 (本机 pip 解 + trivy 0.72.0 复现, 非推断):
#   基础镜像 python:3.11.17-slim-bookworm 自带 pip 24.0, 其 `pip/_vendor/` 里
#   vendor 的是 msgpack==1.0.5 / urllib3==1.26.17 / setuptools==68.0.0 ——
#   **这三条 trivy 一条都不报** (对照: mcp 镜像同样 pip 24.0, image-scan 已绿)。
#   一旦 `--upgrade pip` 到 26.2.1, vendor 变成
#     msgpack==1.1.2  → GHSA-6v7p-g79w-8964 (修于 1.2.1)
#     urllib3==2.7.0  → CVE-2026-97687 / CVE-2026-97689 (修于 2.8.0)
#     setuptools==70.3.0 → CVE-2025-47273 (修于 78.1.1)
#   ⇒ trivy 按 `pip/_vendor/vendor.txt` 逐条报, 4 条 HIGH 全部来自**升级后的 pip
#     自带的 vendor**, 与我们真正装的 faster-whisper 无关。
#   ⚠️ 这些 vendor 是 pip 自身源码的一部分, `pip install "msgpack>=1.2.1"` 之类
#     **升不动它** (实测: 只会在 site-packages 顶层多装一份, vendor.txt 不变)。
#     ⇒ 唯一稳妥修法 = **不升级 pip**, 让基础镜像的干净 vendor 留着。
# pip 24.0 支持下面的 `--prefer-binary`, 功能无损失。
RUN pip3 install --no-cache-dir --upgrade setuptools \
    && pip3 install --no-cache-dir --prefer-binary \
    faster-whisper==1.2.1 \
    nvidia-cublas-cu12 \
    nvidia-cuda-nvrtc-cu12 \
    fastapi uvicorn python-multipart

# 设置CUDA库路径
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib

# v31.3.1: 不再 COPY app/whisper_server.py 进镜像
# 改用 docker-compose.yml bind mount ./app/whisper_server.py:/app/whisper_server.py:ro
# 优势: 本地源码改动 → docker compose restart 即可生效, 不需要 rebuild 镜像
# (旧方案 Dockerfile COPY 烧进镜像 → 源码改动后必须 rebuild 才能看到, 违反 CLAUDE.md 7a 教训)

# 环境变量（可通过 docker-compose 覆盖）
ENV MODEL_SIZE=large-v3
ENV DEVICE=cuda

# 暴露端口
EXPOSE 8002

# 启动命令 - 使用自定义 FastAPI 服务
CMD ["python3", "whisper_server.py"]
